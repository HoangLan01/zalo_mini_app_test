# Frontend mini app local credentials
# Copy this file to .env.local for local development only.
APP_ID=your_zalo_mini_app_id
ZMP_TOKEN=your_local_zmp_token

# API
# Local development default. Production builds must pass an explicit public API URL.
VITE_API_URL=http://localhost:3001
VITE_ZALO_OA_ID=your_zalo_oa_id
VITE_ENABLE_DEV_AUTH=false

# For Zalo/device testing, replace with your tunnel or staging API URL:
# VITE_API_URL=https://<random>.trycloudflare.com
