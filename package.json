{
  "name": "my-app-test-1",
  "version": "1.0.0",
  "packageManager": "npm@11.7.0",
  "description": "Zalo Mini App cho Phường Tùng Thiện với các tính năng phản ánh, đặt lịch và tiện ích hành chính.",
  "main": "index.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:env-examples": "node scripts/check-env-examples.mjs",
    "check:vi-encoding": "node scripts/check-vietnamese-encoding.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dompurify": "^3.4.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-transition-group": "^4.4.5",
    "sass": "^1.99.0",
    "zmp-sdk": "^2.51.6",
    "zmp-ui": "^1.11.14",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-transition-group": "^4.4.10",
    "@vitejs/plugin-react": "^1.3.2",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.10",
    "zmp-vite-plugin": "^1.1.6"
  }
}
