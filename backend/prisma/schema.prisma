generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OAToken {
  id           String   @id
  accessToken  String
  refreshToken String
  expiresAt    DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("oa_tokens")
}

model User {
  id           String        @id @default(uuid())
  zaloId       String?       @unique @db.VarChar(64)
  displayName  String        @db.VarChar(255)
  avatarUrl    String?
  email        String?       @unique @db.VarChar(255)
  passwordHash String?
  phoneToken   String?
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  bookings     Booking[]
  feedbacks    Feedback[]
  ratings      Rating[]
  attempts     QuizAttempt[]

  @@index([createdAt(sort: Desc)])
  @@index([zaloId])
  @@index([email])
  @@map("users")
}

model Booking {
  id              String        @id @default(uuid())
  code            String        @unique @db.VarChar(20)
  userId          String
  field           BookingField
  preferredDate   DateTime      @db.Timestamptz(6)
  preferredTime   String        @db.VarChar(5)
  confirmedDate   DateTime?     @db.Timestamptz(6)
  confirmedTime   String?       @db.VarChar(5)
  description     String
  contactName     String        @db.VarChar(100)
  status          BookingStatus @default(PENDING)
  rejectionReason String?
  rescheduledNote String?
  reminder24hSent Boolean       @default(false)
  reminder1hSent  Boolean       @default(false)
  oaMessageId     String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([userId])
  @@index([userId, status])
  @@map("bookings")
}

model Feedback {
  id          String           @id @default(uuid())
  code        String           @unique @db.VarChar(20)
  userId      String
  title       String           @db.VarChar(100)
  category    FeedbackCategory
  description String
  imageUrls   String[]         @default([])
  latitude    Float?
  longitude   Float?
  address     String?
  status      FeedbackStatus   @default(PENDING)
  response    String?
  respondedAt DateTime?        @db.Timestamptz(6)
  oaMessageId String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([userId])
  @@index([userId, status])
  @@map("feedbacks")
}

model Rating {
  id              String   @id @default(uuid())
  userId          String
  procedure       String   @db.VarChar(100)
  attitudeScore   Int      @db.SmallInt
  timelinessScore Int      @db.SmallInt
  outcomeScore    Int      @db.SmallInt
  averageScore    Decimal  @db.Decimal(3, 1)
  comment         String?
  alertSent       Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id])

  @@index([averageScore], map: "ratings_avgScore_idx")
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("ratings")
}

model QuizTopic {
  id          String    @id @default(uuid())
  slug        String    @unique @db.VarChar(120)
  title       String    @db.VarChar(255)
  description String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  archivedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  sets        QuizSet[]

  @@index([isActive, archivedAt, order])
  @@map("quiz_topics")
}

model QuizSet {
  id          String        @id @default(uuid())
  topicId     String
  title       String        @db.VarChar(255)
  description String?
  timeLimit   Int
  status      QuizSetStatus @default(DRAFT)
  version     Int           @default(1)
  order       Int           @default(0)
  publishedAt DateTime?     @db.Timestamptz(6)
  closedAt    DateTime?     @db.Timestamptz(6)
  archivedAt  DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  topic       QuizTopic     @relation(fields: [topicId], references: [id])
  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([topicId, status, archivedAt, order])
  @@map("quiz_sets")
}

model QuizQuestion {
  id          String       @id @default(uuid())
  quizSetId   String
  content     String
  type        QuestionType @default(MULTIPLE_CHOICE)
  points      Int          @default(10)
  order       Int          @default(0)
  explanation String?
  archivedAt  DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  quizSet     QuizSet      @relation(fields: [quizSetId], references: [id])
  options     QuizOption[]
  answers     QuizAttemptAnswer[]

  @@index([quizSetId, archivedAt, order])
  @@map("quiz_questions")
}

model QuizOption {
  id          String              @id @default(uuid())
  questionId  String
  content     String
  order       Int                 @default(0)
  isCorrect   Boolean             @default(false)
  archivedAt  DateTime?           @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  question    QuizQuestion        @relation(fields: [questionId], references: [id])
  answers     QuizAttemptAnswer[]

  @@index([questionId, archivedAt, order])
  @@map("quiz_options")
}

model QuizAttempt {
  id          String              @id @default(uuid())
  userId      String
  quizSetId   String
  score       Int                 @default(0)
  maxScore    Int                 @default(0)
  timeTaken   Int                 @default(0)
  status      QuizAttemptStatus   @default(IN_PROGRESS)
  startedAt   DateTime            @default(now()) @db.Timestamptz(6)
  submittedAt DateTime?           @db.Timestamptz(6)
  user        User                @relation(fields: [userId], references: [id])
  quizSet     QuizSet             @relation(fields: [quizSetId], references: [id])
  answers     QuizAttemptAnswer[]

  @@unique([userId, quizSetId])
  @@index([quizSetId, score(sort: Desc), timeTaken, submittedAt])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id                    String       @id @default(uuid())
  attemptId             String
  questionId            String
  selectedOptionId      String?
  isCorrect             Boolean      @default(false)
  pointsAwarded         Int          @default(0)
  questionContent       String
  selectedOptionContent String?
  correctOptionContent  String?
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  attempt               QuizAttempt  @relation(fields: [attemptId], references: [id])
  question              QuizQuestion @relation(fields: [questionId], references: [id])
  selectedOption        QuizOption?  @relation(fields: [selectedOptionId], references: [id])

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_attempt_answers")
}

enum UserRole {
  USER
  ADMIN
}

enum QuizSetStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum FeedbackStatus {
  PENDING
  PROCESSING
  TRANSFERRED
  RESOLVED
}

enum FeedbackCategory {
  HA_TANG
  VE_SINH
  TRAT_TU
  AN_NINH
  KHAC
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum BookingField {
  HO_TICH
  CU_TRU
  CHUNG_THUC
  DAT_DAI
  XA_HOI
  KHAC
}
