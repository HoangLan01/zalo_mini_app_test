{
  "name": "tung-thien-backend",
  "version": "1.0.0",
  "description": "Zalo Mini App Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed:quiz": "ts-node src/seedQuiz.ts",
    "db:bootstrap-super-admin": "ts-node src/bootstrapSuperAdmin.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:ci": "jest --coverage --ci --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@prisma/client": "^5.x",
    "axios": "^1.17.0",
    "bcryptjs": "^2.x",
    "cloudinary": "^2.x",
    "cors": "^2.x",
    "dotenv": "^16.x",
    "express": "^4.x",
    "express-rate-limit": "^7.x",
    "helmet": "^7.x",
    "jsonwebtoken": "^9.x",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "sanitize-html": "^2.17.4",
    "winston": "^3.x",
    "zod": "^3.x"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.x",
    "@types/cors": "^2.x",
    "@types/express": "^4.x",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.x",
    "@types/multer": "^1.x",
    "@types/node": "^20.x",
    "@types/node-cron": "^3.x",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^5.x",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.x",
    "ts-node-dev": "^2.x",
    "typescript": "^5.x"
  }
}
