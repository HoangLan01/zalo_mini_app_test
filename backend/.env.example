# Server
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

# Database
DATABASE_URL=

# JWT
JWT_SECRET=thay_bang_chuoi_random_bao_mat_cua_ban
JWT_EXPIRES_IN=7d

# Local seed/admin defaults are only for development. Set real values before production seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# Dev auth is disabled unless this value is exactly "true"; never enable it in production.
ENABLE_DEV_AUTH=true
DEV_AUTH_ZALO_ID=dev-zalo-user
DEV_AUTH_DISPLAY_NAME=Người dùng thử nghiệm

# Zalo App
ZALO_APP_ID=
ZALO_APP_SECRET=

# Zalo OA
ZALO_OA_ID=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET_KEY=
ZALO_BOOKING_ADMIN_USER_IDS=

# ZNS
ZALO_ZNS_OA_TOKEN=
ZNS_TEMPLATE_BOOKING_RECEIVED=
ZNS_TEMPLATE_BOOKING_CONFIRMED=
ZNS_TEMPLATE_BOOKING_REJECTED=
ZNS_TEMPLATE_BOOKING_REMINDER=
ZNS_TEMPLATE_FEEDBACK_RECEIVED=
ZNS_TEMPLATE_FEEDBACK_UPDATED=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX_REQUESTS=30
RATE_LIMIT_ADMIN_QUIZ_MAX_REQUESTS=500
RATE_LIMIT_ADMIN_BOOKING_MAX_REQUESTS=500
RATE_LIMIT_PUBLIC_QUIZ_MAX_REQUESTS=500
