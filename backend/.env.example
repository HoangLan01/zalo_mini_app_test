# Server
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3100

# Database
DATABASE_URL=

# JWT
JWT_SECRET=thay_bang_chuoi_random_bao_mat_cua_ban
JWT_EXPIRES_IN=2h
ADMIN_JWT_EXPIRES_IN=8h
COOKIE_DOMAIN=
ADMIN_COOKIE_SAME_SITE=strict

# Bootstrap SUPER_ADMIN
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=

# Dev auth is disabled unless this value is exactly "true".
# Only enable for local development. NEVER enable in production.
ENABLE_DEV_AUTH=false
DEV_AUTH_ZALO_ID=dev-zalo-user
DEV_AUTH_DISPLAY_NAME=Nguoi dung thu nghiem

# Zalo App
ZALO_APP_ID=
ZALO_APP_SECRET=

# Zalo OA
ZALO_OA_ID=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET_KEY=
ZALO_BOOKING_ADMIN_USER_IDS=

# ZNS
ZALO_ZNS_OA_TOKEN=
ZNS_TEMPLATE_BOOKING_RECEIVED=
ZNS_TEMPLATE_BOOKING_CONFIRMED=
ZNS_TEMPLATE_BOOKING_REJECTED=
ZNS_TEMPLATE_BOOKING_REMINDER=
ZNS_TEMPLATE_FEEDBACK_RECEIVED=
ZNS_TEMPLATE_FEEDBACK_UPDATED=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_CREATION_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX_REQUESTS=1000
RATE_LIMIT_GLOBAL_IP_MAX_REQUESTS=1500
RATE_LIMIT_AUTH_MAX_REQUESTS=30
RATE_LIMIT_ADMIN_QUIZ_MAX_REQUESTS=500
RATE_LIMIT_ADMIN_BOOKING_MAX_REQUESTS=500
RATE_LIMIT_PUBLIC_QUIZ_MAX_REQUESTS=500
RATE_LIMIT_FEEDBACK_CREATE_IP_MAX_REQUESTS=10
RATE_LIMIT_FEEDBACK_CREATE_MAX_REQUESTS=10
RATE_LIMIT_BOOKING_CREATE_IP_MAX_REQUESTS=10
RATE_LIMIT_BOOKING_CREATE_MAX_REQUESTS=10
RATE_LIMIT_RATING_CREATE_IP_MAX_REQUESTS=10
RATE_LIMIT_RATING_CREATE_MAX_REQUESTS=10
